--- !u!114 &8648074042285301974
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7869502990812765110}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<gazebo reference=\"laser_tilt_link\">\r\n  <sensor name=\"laser_tilt\"
    type=\"ray\">\r\n    <always_on>true</always_on>\r\n    <update_rate>40</update_rate>\r\n   
    <pose>0 0 0 0 0 0</pose>\r\n    <visualize>false</visualize>\r\n    <ray>\r\n     
    <scan>\r\n        <horizontal>\r\n          <samples>640</samples>\r\n         
    <resolution>1</resolution>\r\n          <min_angle>-1.3962634</min_angle>\r\n         
    <max_angle>1.3962634</max_angle>\r\n        </horizontal>\r\n      </scan>\r\n     
    <range>\r\n        <min>0.08</min>\r\n        <max>10.0</max>\r\n        <resolution>0.01</resolution>\r\n     
    </range>\r\n    </ray>\r\n    <plugin filename=\"libgazebo_ros_laser.so\" name=\"gazebo_ros_laser_tilt_controller\">\r\n     
    <gaussianNoise>0.005</gaussianNoise>\r\n      <alwaysOn>true</alwaysOn>\r\n     
    <updateRate>40</updateRate>\r\n      <topicName>tilt_scan</topicName>\r\n     
    <frameName>laser_tilt_link</frameName>\r\n      <hokuyoMinIntensity>101</hokuyoMinIntensity>\r\n   
    </plugin>\r\n  </sensor>\r\n</gazebo>"
