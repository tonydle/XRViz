  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<gazebo reference=\"high_def_frame\">\r\n  <sensor name=\"high_def_sensor\"
    type=\"camera\">\r\n    <always_on>true</always_on>\r\n    <update_rate>20.0</update_rate>\r\n   
    <camera>\r\n      <horizontal_fov>0.7853981633974483</horizontal_fov>\r\n     
    <image>\r\n        <format>R8G8B8</format>\r\n        <width>2448</width>\r\n       
    <height>2050</height>\r\n      </image>\r\n      <clip>\r\n        <near>0.1</near>\r\n       
    <far>100</far>\r\n      </clip>\r\n    </camera>\r\n    <plugin filename=\"libgazebo_ros_prosilica.so\"
    name=\"high_def_controller\">\r\n      <updateRate>20.0</updateRate>\r\n     
    <cameraName>prosilica</cameraName>\r\n      <imageTopicName>image_raw</imageTopicName>\r\n     
    <cameraInfoTopicName>camera_info</cameraInfoTopicName>\r\n      <pollServiceName>request_image</pollServiceName>\r\n     
    <frameName>high_def_optical_frame</frameName>\r\n      <CxPrime>1224.5</CxPrime>\r\n     
    <Cx>1224.5</Cx>\r\n      <Cy>1025.5</Cy>\r\n      <focalLength>2954.998083</focalLength>\r\n     
    <distortionK1>0.0</distortionK1>\r\n      <distortionK2>0.0</distortionK2>\r\n     
    <distortionK3>0.0</distortionK3>\r\n      <distortionT1>0.0</distortionT1>\r\n     
    <distortionT2>0.0</distortionT2>\r\n    </plugin>\r\n  </sensor>\r\n  <material
    value=\"Gazebo/Black\" />\r\n</gazebo>"
