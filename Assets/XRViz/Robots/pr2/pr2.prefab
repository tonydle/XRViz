  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<gazebo reference=\"wide_stereo_l_stereo_camera_frame\">\r\n  <sensor
    name=\"wide_stereo_l_stereo_camera_sensor\" type=\"camera\">\r\n    <always_on>true</always_on>\r\n   
    <update_rate>25.0</update_rate>\r\n    <camera>\r\n      <horizontal_fov>1.5707963267948966</horizontal_fov>\r\n     
    <image>\r\n        <format>BAYER_BGGR8</format>\r\n        <width>640</width>\r\n       
    <height>480</height>\r\n      </image>\r\n      <clip>\r\n        <near>0.1</near>\r\n       
    <far>100</far>\r\n      </clip>\r\n    </camera>\r\n    <plugin filename=\"libgazebo_ros_camera.so\"
    name=\"wide_stereo_l_stereo_camera_controller\">\r\n      <alwaysOn>true</alwaysOn>\r\n     
    <updateRate>25.0</updateRate>\r\n      <cameraName>wide_stereo/left</cameraName>\r\n     
    <imageTopicName>image_raw</imageTopicName>\r\n      <cameraInfoTopicName>camera_info</cameraInfoTopicName>\r\n     
    <frameName>wide_stereo_optical_frame</frameName>\r\n      <hackBaseline>0</hackBaseline>\r\n     
    <CxPrime>320.5</CxPrime>\r\n      <Cx>320.5</Cx>\r\n      <Cy>240.5</Cy>\r\n     
    <!-- image_width / (2*tan(hfov_radian /2)) -->\r\n      <!-- 320 for wide and
    772.55 for narrow stereo camera -->\r\n      <focalLength>320.000105</focalLength>\r\n     
    <distortionK1>0.0</distortionK1>\r\n      <distortionK2>0.0</distortionK2>\r\n     
    <distortionK3>0.0</distortionK3>\r\n      <distortionT1>0.0</distortionT1>\r\n     
    <distortionT2>0.0</distortionT2>\r\n    </plugin>\r\n  </sensor>\r\n  <turnGravityOff>true</turnGravityOff>\r\n 
    <material>PR2/Blue</material>\r\n</gazebo>"
