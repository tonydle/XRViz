--- !u!114 &4130933936837786216
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7869502990812765110}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<gazebo>\r\n  <plugin filename=\"libgazebo_ros_p3d.so\" name=\"p3d_l_gripper_palm_controller\">\r\n   
    <alwaysOn>true</alwaysOn>\r\n    <updateRate>100.0</updateRate>\r\n    <bodyName>l_gripper_palm_link</bodyName>\r\n   
    <topicName>l_gripper_palm_pose_ground_truth</topicName>\r\n    <xyzOffsets>0
    0 0</xyzOffsets>\r\n    <rpyOffsets>0 0 0</rpyOffsets>\r\n    <gaussianNoise>0.0</gaussianNoise>\r\n   
    <frameName>map</frameName>\r\n  </plugin>\r\n  <!-- a formal implementation of
    grasp hack in gazebo with fixed joint -->\r\n  <gripper name=\"l_grasp_hack\">\r\n   
    <grasp_check>\r\n      <attach_steps>20</attach_steps>\r\n      <detach_steps>40</detach_steps>\r\n     
    <min_contact_count>2</min_contact_count>\r\n    </grasp_check>\r\n    <gripper_link>l_gripper_r_finger_tip_link</gripper_link>\r\n   
    <gripper_link>l_gripper_l_finger_tip_link</gripper_link>\r\n    <palm_link>l_gripper_palm_link</palm_link>\r\n 
    </gripper>\r\n</gazebo>"
--- !u!114 &6551340659259378511
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7869502990812765110}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<transmission name=\"l_gripper_trans\" type=\"pr2_mechanism_model/PR2GripperTransmission\">\r\n 
    <actuator name=\"l_gripper_motor\" />\r\n  <gap_joint L0=\"0.0375528\" a=\"0.0683698\"
    b=\"0.043384900000000004\" gear_ratio=\"40.095\" h=\"0.0\" mechanical_reduction=\"1.0\"
    name=\"l_gripper_joint\" phi0=\"0.5185181221457433\" r=\"0.0915\" screw_reduction=\"0.004\"
    t0=\"-0.0001914\" theta0=\"0.0628824676201037\" />\r\n  <!-- if a gazebo joint
    exists as [l|r]_gripper_joint, use this tag to have\r\n           gripper transmission
    apply torque directly to prismatic joint\r\n           this should be the default
    behavior in diamondback, deprecating this flag -->\r\n  <use_simulated_gripper_joint
    />\r\n  <!-- set passive joint angles so things look nice in rviz -->\r\n  <passive_joint
    name=\"l_gripper_l_finger_joint\" />\r\n  <passive_joint name=\"l_gripper_r_finger_joint\"
    />\r\n  <passive_joint name=\"l_gripper_r_finger_tip_joint\" />\r\n  <passive_joint
    name=\"l_gripper_l_finger_tip_joint\" />\r\n  <!-- screw joint to capture gripper
    \"dynamics\" -->\r\n  <simulated_actuated_joint name=\"l_gripper_motor_screw_joint\"
    passive_actuated_joint=\"l_gripper_motor_slider_joint\" simulated_reduction=\"3141.6\"
    />\r\n</transmission>"
--- !u!114 &7260886999378619787
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7869502990812765110}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<gazebo reference=\"l_forearm_cam_frame\">\r\n  <sensor name=\"l_forearm_cam_sensor\"
    type=\"camera\">\r\n    <always_on>true</always_on>\r\n    <update_rate>25.0</update_rate>\r\n   
    <camera>\r\n      <horizontal_fov>1.5707963267948966</horizontal_fov>\r\n     
    <image>\r\n        <format>R8G8B8</format>\r\n        <width>640</width>\r\n       
    <height>480</height>\r\n      </image>\r\n      <clip>\r\n        <near>0.1</near>\r\n       
    <far>100</far>\r\n      </clip>\r\n    </camera>\r\n    <plugin filename=\"libgazebo_ros_camera.so\"
    name=\"l_forearm_cam_controller\">\r\n      <alwaysOn>true</alwaysOn>\r\n     
    <updateRate>25.0</updateRate>\r\n      <cameraName>l_forearm_cam</cameraName>\r\n     
    <imageTopicName>image_raw</imageTopicName>\r\n      <cameraInfoTopicName>camera_info</cameraInfoTopicName>\r\n     
    <frameName>l_forearm_cam_optical_frame</frameName>\r\n      <hackBaseline>0</hackBaseline>\r\n     
    <CxPrime>320.5</CxPrime>\r\n      <Cx>320.5</Cx>\r\n      <Cy>240.5</Cy>\r\n     
    <!-- image_width / (2*tan(hfov_radian /2)) -->\r\n      <!-- 320 for wide and
    772.55 for narrow stereo camera -->\r\n      <focalLength>320.000105</focalLength>\r\n     
    <distortionK1>0.0</distortionK1>\r\n      <distortionK2>0.0</distortionK2>\r\n     
    <distortionK3>0.0</distortionK3>\r\n      <distortionT1>0.0</distortionT1>\r\n     
    <distortionT2>0.0</distortionT2>\r\n    </plugin>\r\n  </sensor>\r\n  <turnGravityOff>true</turnGravityOff>\r\n 
    <material>PR2/Blue</material>\r\n</gazebo>"
