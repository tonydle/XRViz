  PluginText: "<gazebo>\r\n  <joint name=\"l_gripper_r_screw_screw_joint\" type=\"screw\">\r\n   
    <child>l_gripper_motor_screw_link</child>\r\n    <parent>l_gripper_r_finger_tip_link</parent>\r\n   
    <thread_pitch>-3141.6</thread_pitch>\r\n    <axis>\r\n      <xyz>0 1 0</xyz>\r\n   
    </axis>\r\n  </joint>\r\n  <joint name=\"l_gripper_l_screw_screw_joint\" type=\"screw\">\r\n   
    <parent>l_gripper_l_finger_tip_link</parent>\r\n    <child>l_gripper_motor_screw_link</child>\r\n   
    <thread_pitch>3141.6</thread_pitch>\r\n    <axis>\r\n      <xyz>0 1 0</xyz>\r\n   
    </axis>\r\n  </joint>\r\n</gazebo>"
--- !u!114 &5702200219160625025
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7869502990812765110}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<gazebo>\r\n  <joint name=\"l_gripper_r_parallel_root_joint\" type=\"revolute\">\r\n   
    <parent>l_gripper_r_parallel_link</parent>\r\n    <child>l_gripper_palm_link</child>\r\n   
    <axis>\r\n      <xyz>0 0 -1</xyz>\r\n      <dynamics>\r\n        <damping>0.2</damping>\r\n     
    </dynamics>\r\n    </axis>\r\n    <pose>0.058910000000000004 -0.031 0 0 0 0</pose>\r\n 
    </joint>\r\n  <joint name=\"l_gripper_l_parallel_root_joint\" type=\"revolute\">\r\n   
    <parent>l_gripper_l_parallel_link</parent>\r\n    <child>l_gripper_palm_link</child>\r\n   
    <axis>\r\n      <xyz>0 0 1</xyz>\r\n      <dynamics>\r\n        <damping>0.2</damping>\r\n     
    </dynamics>\r\n    </axis>\r\n    <pose>0.058910000000000004 0.031 0 0 0 0</pose>\r\n 
    </joint>\r\n  <joint name=\"l_gripper_r_parallel_tip_joint\" type=\"revolute\">\r\n   
    <parent>l_gripper_r_parallel_link</parent>\r\n    <child>l_gripper_r_finger_tip_link</child>\r\n   
    <axis>\r\n      <xyz>0 0 1</xyz>\r\n    </axis>\r\n    <pose>-0.018 -0.021 0
    0 0 0</pose>\r\n  </joint>\r\n  <joint name=\"l_gripper_l_parallel_tip_joint\"
    type=\"revolute\">\r\n    <parent>l_gripper_l_parallel_link</parent>\r\n    <child>l_gripper_l_finger_tip_link</child>\r\n   
    <axis>\r\n      <xyz>0 0 1</xyz>\r\n    </axis>\r\n    <pose>-0.018 0.021 0 0
    0 0</pose>\r\n  </joint>\r\n  <joint name=\"l_gripper_joint\" type=\"prismatic\">\r\n   
    <parent>l_gripper_r_finger_tip_link</parent>\r\n    <child>l_gripper_l_finger_tip_link</child>\r\n   
    <axis>\r\n      <xyz>0 1 0</xyz>\r\n    </axis>\r\n  </joint>\r\n</gazebo>"
