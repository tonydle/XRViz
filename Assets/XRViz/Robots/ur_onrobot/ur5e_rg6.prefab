    name=\"mimic_left_inner_finger_joint\">\r\n    <joint>finger_joint</joint>\r\n   
    <mimicJoint>left_inner_finger_joint</mimicJoint>\r\n    <multiplier>1.0</multiplier>\r\n   
    <offset>0.0</offset>\r\n    <maxEffort>5.0</maxEffort>\r\n    <!-- <hasPID />
