  PluginText: "<gazebo>\r\n  <plugin filename=\"libroboticsgroup_upatras_gazebo_mimic_joint_plugin.so\"
    name=\"mimic_left_inner_knuckle_joint\">\r\n    <joint>finger_joint</joint>\r\n   
